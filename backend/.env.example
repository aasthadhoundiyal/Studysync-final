# Server
NODE_ENV=development
PORT=5000

# MongoDB (use 127.0.0.1 instead of localhost to avoid IPv6 resolution issues on Windows)
MONGO_URI=mongodb://127.0.0.1:27017/studysync

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Default admin account (created by `npm run seed:admin`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@studysync.local
ADMIN_PASSWORD=change-me-strong-password

# Gemini AI (optional — AI features are disabled gracefully when absent)
# Obtain your key from: https://aistudio.google.com/app/apikey
# NEVER expose this key to frontend/React code.
GEMINI_API_KEY=your-gemini-api-key-here

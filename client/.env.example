# StudySync Frontend Environment Variables
# Copy this file to .env for local development

# Base URL for the StudySync Express backend API
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL for backend uploaded media (images, attachments)
VITE_UPLOADS_BASE_URL=http://localhost:5000

# Application branding
VITE_APP_NAME=StudySync

# SECURITY NOTE:
# Never put backend secrets, database connection strings, or third-party API keys (like GEMINI_API_KEY)
# in client environment variables. Vite embeds VITE_* variables directly into the public bundle.
